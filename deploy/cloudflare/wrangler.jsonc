{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "slipshod",
	"main": "src/index.js",
	"compatibility_date": "2026-11-01",
	"observability": { "enabled": true },
	"containers": [
		{
			"class_name": "SlipshodApp",
			"scheduling_policy": "durable_object",
			"images": {
				"base": {
					"dockerfile": "../../Dockerfile",
					"build_context": "../..",
				},
			},
		},
	],
	"durable_objects": {
		"bindings": [{ "name": "APP", "class_name": "SlipshodApp" }],
	},
	"exports": {
		"SlipshodApp": { "type": "durable-object", "storage": "sqlite" },
	},
	"routes": [{ "pattern": "ancep.yaqeen.me", "custom_domain": true }],
}
